---
import { about } from "../data/content";
---

<section id="about" class="mx-auto max-w-5xl px-5 py-24 sm:px-8">
  <div class="grid gap-12 md:grid-cols-[1fr_1.6fr]">
    <div class="reveal">
      <p class="font-mono text-sm font-medium uppercase tracking-widest text-accent">
        01 — About
      </p>
      <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">
        Engineering that holds up in production.
      </h2>
    </div>

    <div class="reveal" style="transition-delay: 100ms;">
      <div class="space-y-5 text-lg leading-relaxed text-muted">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-muted">
          Top skills
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            about.topSkills.map((s) => (
              <li class="rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm font-medium text-fg">
                {s}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
