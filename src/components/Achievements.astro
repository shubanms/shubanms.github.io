---
import { achievements } from "../data/content";
---

<section id="achievements" class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      achievements.map((a, i) => (
        <div
          class="reveal rounded-2xl border border-border bg-surface p-6"
          style={`transition-delay: ${i * 70}ms;`}
        >
          <h3 class="font-display text-base font-semibold text-fg">{a.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{a.body}</p>
        </div>
      ))
    }
  </div>
</section>
