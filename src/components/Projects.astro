---
import { projects } from "../data/content";
---

<section id="projects" class="mx-auto max-w-5xl px-5 py-24 sm:px-8">
  <div class="reveal mb-14">
    <p class="font-mono text-sm font-medium uppercase tracking-widest text-accent">
      04 — Projects
    </p>
    <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">
      Things I've shipped.
    </h2>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    {
      projects.map((p, i) => (
        <article
          class="tilt group relative flex flex-col rounded-2xl border border-border bg-surface p-6 sm:p-7"
          data-tilt
          style={`transition-delay: ${(i % 2) * 60}ms;`}
        >
          <div class="reveal flex items-start justify-between gap-4">
            <div class="flex flex-col gap-1.5">
              <h3 class="font-display text-lg font-semibold text-fg sm:text-xl">
                {p.title}
              </h3>
              {p.status && (
                <span class="inline-flex w-fit items-center gap-1.5 rounded-full border border-accent/40 bg-accent-soft px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-accent">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent" />
                  {p.status}
                </span>
              )}
            </div>
            <div class="flex shrink-0 gap-3 text-muted">
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${p.title} on GitHub`}
                  class="transition-colors hover:text-accent"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.56 9.56 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0022 12c0-5.52-4.48-10-10-10z"/></svg>
                </a>
              )}
              {p.demo && (
                <a
                  href={p.demo}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${p.title} live demo`}
                  class="transition-colors hover:text-accent"
                >
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5m0-5L10 14M9 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-3"/></svg>
                </a>
              )}
            </div>
          </div>

          <p class="reveal mt-3 flex-1 text-[15px] leading-relaxed text-muted">
            {p.description}
          </p>

          <ul class="reveal mt-5 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <li class="rounded-md bg-accent-soft px-2.5 py-1 font-mono text-xs text-accent">
                {t}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<script>
  // 3D tilt — runs only on devices with a real pointer + no reduced motion
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hover = window.matchMedia("(hover: hover)").matches;

  if (!reduce && hover) {
    const cards = document.querySelectorAll<HTMLElement>("[data-tilt]");
    cards.forEach((card) => {
      const maxTilt = 6;
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateY(${px * maxTilt}deg) rotateX(${-py * maxTilt}deg) translateY(-2px)`;
        card.style.borderColor = "var(--accent)";
      });
      card.addEventListener("mouseleave", () => {
        card.style.transform = "";
        card.style.borderColor = "";
      });
    });
  }
</script>
